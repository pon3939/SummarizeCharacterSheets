      },
      "lambda": {
        "runtime": "python3.12",
        "pathMappings": [
          {
            "localRoot": "${workspaceFolder}/source/functions/insert_level_caps",
            "remoteRoot": "/var/task"
          },
          {
            "localRoot": "${workspaceFolder}/source/layers/my_modules",
            "remoteRoot": "/opt/python/my_modules"
          }
        ]
      },
      "sam": {
        "containerBuild": false,
        "localArguments": [
          "-e",
          "${workspaceFolder}/source/functions/local_inputs/insert_level_caps.json",
          "-n",
          "${workspaceFolder}/source/local_env.json"
        ],
        "skipNewImageCheck": false
      },
      "name": "InsertLevelCapsFunction",
      "preLaunchTask": "install libraries"
